<UserControl x:Class="FileTransferReco.Views.FileTransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FileTransferReco.Views"
             xmlns:p="http://prismlibrary.com/"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="15*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Background="AliceBlue">

            <TextBlock x:Name="selectEquipment" Text="选择设备"  TextAlignment="Center" VerticalAlignment="Center">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <p:InvokeCommandAction
                            Command="{Binding SelectEquipment}"
                            CommandParameter="{Binding ElementName=selectEquipment}"
                            />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </TextBlock>
        </Grid>
        <ListBox Grid.Row="1">
            <ListBoxItem>1</ListBoxItem>
            <ListBoxItem>1</ListBoxItem>
            <ListBoxItem>1</ListBoxItem>
        </ListBox>

        <DockPanel Grid.Row="2" Background="AliceBlue">
            <Button DockPanel.Dock="Right" MinWidth="70" 
                    Command="{Binding SendFile}" 
                    CommandParameter="{Binding ElementName=selectTextBlock}"
                    >发送</Button>
            <TextBlock x:Name="selectTextBlock" TextAlignment="Center" VerticalAlignment="Center" Text="选择文件" >
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonDown">
                        <p:InvokeCommandAction
                            Command="{Binding OpenSelecteFileDialog}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=TextBlock}}"
                            />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </TextBlock>
        </DockPanel>
    </Grid>
</UserControl>
